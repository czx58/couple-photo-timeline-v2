          "name": "食用油",
          "category": "seasoning",
          "standardAmount": 10,
          "isSeasoning": true,
          "capAmount": {
            "level": "half",
            "capRef": "≈半瓷勺/≈10ml"
          }
        },
        {
          "id": "soy-sauce-light",
          "name": "生抽",
          "category": "seasoning",
          "standardAmount": 12,
          "isSeasoning": true,
          "capAmount": {
            "level": "full",
            "capRef": "≈1瓶盖/≈12ml"
          }
        },
        {
          "id": "soy-sauce-dark",
          "name": "老抽",
          "category": "seasoning",
          "standardAmount": 3,
          "isSeasoning": true,
          "capAmount": {
            "level": "half",
            "capRef": "≈半瓶盖/≈3ml（只上色少放）"
          }
        },
        {
          "id": "salt",
          "name": "盐",
          "category": "seasoning",
          "standardAmount": 2,
          "isSeasoning": true,
          "capAmount": {
            "level": "flat",
            "capRef": "≈2克/平盖少半勺"
          }
        }
      ],
      "prepOrder": [
        "鸡翅正反面划两刀（让汁进去）",
        "冷水下锅焯水，水开捞出冲干净",
        "切 3-4 片姜"
      ],
      "steps": [
        {
          "order": 1,
          "action": "锅里倒油，放姜片小火煸出香味",
          "heatLevel": "小火",
          "heatTranslation": "电磁炉 400W",
          "judgment": "姜片变金黄就行，别糊",
          "duration": "1分钟"
        },
        {
          "order": 2,
          "action": "放鸡翅，小火慢煎两面都变金黄",
          "heatLevel": "小火",
          "heatTranslation": "电磁炉 400W",
          "judgment": "两面都金黄金黄的=可以了",
          "duration": "每面 3 分钟，共 6 分钟"
        },
        {
          "order": 3,
          "action": "倒生抽和老抽，翻几下让每个鸡翅都上色",
          "heatLevel": "中火",
          "heatTranslation": "电磁炉 800W",
          "duration": "1分钟"
        },
        {
          "order": 4,
          "action": "倒可乐，刚好没过鸡翅。不够加水。撒一点点盐",
          "heatLevel": "大火",
          "heatTranslation": "电磁炉 1600W",
          "duration": "煮开"
        },
        {
          "order": 5,
          "action": "转小火盖盖子焖 10 分钟",
          "heatLevel": "小火",
          "heatTranslation": "电磁炉 400W",
          "duration": "10分钟"
        },
        {
          "order": 6,
          "action": "开盖，开大火收汁，期间多翻几次防糊",
          "heatLevel": "大火",
          "heatTranslation": "电磁炉 1600W",
          "judgment": "汁变浓稠裹在鸡翅上=关火",
          "duration": "3-5分钟"
        }
      ],
      "tips": {
        "tooSalty": "倒一点可乐或热水再煮一会儿，稀释一下",
        "burnt": "立刻关火，把没糊的鸡翅挑出来，糊底别碰",
        "other": ["鸡翅划两刀才能入味", "焯水能去腥味，别省"]
      }
    }
  ]
