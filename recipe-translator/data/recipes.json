{
  "recipes": [
    {
      "id": "tomato-scrambled-egg",
      "title": "番茄炒蛋",
      "scenes": ["一人快手餐", "能量餐"],
      "difficulty": 1,
      "baseServings": 1,
      "defaultMildFactor": 0.85,
      "ingredients": [
        {
          "id": "egg",
          "name": "鸡蛋",
          "category": "meat",
          "standardAmount": 100,
          "isSeasoning": false,
          "freshness": {
            "shelfLife": "冰箱能放 3-5 周，常温 1 周",
            "checkTip": "放水里：沉下去=新鲜，浮起来=坏了"
          }
        },
        {
          "id": "tomato",
          "name": "大番茄",
          "category": "vegetable",
          "standardAmount": 150,
          "isSeasoning": false,
          "freshness": {
            "shelfLife": "常温放 2-3 天，冰箱放 1 周",
            "checkTip": "捏着软塌塌有汁水流出=快坏了"
          }
        },
        {
          "id": "oil",
          "name": "食用油",
          "category": "seasoning",
          "standardAmount": 15,
          "isSeasoning": true,
          "capAmount": {
            "level": "flat",
            "capRef": "≈1瓷勺/≈15ml"
          }
        },
        {
          "id": "salt",
          "name": "盐",
          "category": "seasoning",
          "standardAmount": 3,
          "isSeasoning": true,
          "capAmount": {
            "level": "half",
            "capRef": "≈3克"
          }
        },
        {
          "id": "sugar",
          "name": "白糖",
          "category": "seasoning",
          "standardAmount": 6,
          "isSeasoning": true,
          "capAmount": {
            "level": "full",
            "capRef": "≈6克"
          }
        }
      ],
      "prepOrder": [
        "先打蛋搅散，放一点点盐（约 1/4 盖）",
        "切番茄：从顶部十字划一刀，再切片",
        "准备好盘子，盛蛋用"
      ],
      "steps": [
        {
          "order": 1,
          "action": "锅里倒油，铺满锅底就行",
          "heatLevel": "小火",
          "heatTranslation": "电磁炉 400W",
          "duration": "1分钟"
        },
        {
          "order": 2,
          "action": "油热了下蛋液，不要立刻搅",
          "heatLevel": "中火",
          "heatTranslation": "电磁炉 800W",
          "judgment": "蛋液底部凝固=刚好",
          "duration": "30秒"
        },
        {
          "order": 3,
          "action": "用铲子划散，鸡蛋刚凝固就盛出到盘子里",
          "judgment": "不要炒到变黄色变老",
          "duration": "20秒"
        },
        {
          "order": 4,
          "action": "锅里再补一点油（约半盖），下番茄",
          "heatLevel": "中火",
          "heatTranslation": "电磁炉 800W",
          "duration": "2分钟"
        },
        {
          "order": 5,
          "action": "加盐和糖，翻炒几下，等番茄出汁咕嘟响",
          "judgment": "番茄出汁咕嘟响=够了，别炒烂",
          "duration": "1分钟"
        },
        {
          "order": 6,
          "action": "把刚才盛出的鸡蛋倒回锅里，翻两下裹上番茄汁，关火",
          "duration": "20秒"
        }
      ],
      "tips": {
        "tooSalty": "加半勺糖或扔几片番茄进去吸盐",
        "burnt": "立刻关火，别去搅糊的部分，上面没糊的还能吃",
        "other": ["鸡蛋一定要先盛出来，不然会变老"]
      }
    },
    {
